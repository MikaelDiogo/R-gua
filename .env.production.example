# Produção (docker-compose.prod.yml). Copie para `.env` no servidor e preencha.
# NUNCA commite o .env real. Gere senhas só com letras e números (elas entram em URLs):
#   openssl rand -hex 24
# Valores abaixo são placeholders; nenhum é segredo real.

# ── Domínio e HTTPS (Caddy) ──
DOMAIN=agora.exemplo.com.br
ACME_EMAIL=<trocar>
APP_ORIGIN=https://${DOMAIN}

# ── Banco (PostgreSQL) ──
# Senha do superusuário: usada só pelo contêiner do banco e pelo backup.
POSTGRES_PASSWORD=<trocar>
# Papéis separados (docs/07 §7). Alteram-se com ALTER ROLE depois da criação do volume (ver docs/12).
MIGRATOR_DB_PASSWORD=<trocar>
APP_DB_PASSWORD=<trocar>
MAINT_DB_PASSWORD=<trocar>
DATABASE_URL=postgres://agora_app:${APP_DB_PASSWORD}@postgres:5432/agora
MIGRATOR_DATABASE_URL=postgres://agora_migrator:${MIGRATOR_DB_PASSWORD}@postgres:5432/agora
WORKER_DATABASE_URL=postgres://agora_worker_maint:${MAINT_DB_PASSWORD}@postgres:5432/agora

# ── Redis ──
REDIS_PASSWORD=<trocar>
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ── Aplicação ──
NODE_ENV=production
# Atrás do Caddy: a API confia no cabeçalho de IP encaminhado.
TRUST_PROXY=1
COOKIE_SECURE=1
MONITOR_SCHEDULER=1

# ── IA e pesquisa web (só no servidor; nunca no front) ──
TAVILY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# ── Ingestão do PNCP (worker) ──
PNCP_BASE_URL=https://pncp.gov.br/api/consulta
PNCP_MAX_CALLS_PER_MIN=12
INGEST_INTERVAL_MIN=360
INGEST_UFS=CE,PI

# ── Opcional ──
# TAG=latest
